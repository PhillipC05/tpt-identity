# tpt-identity configuration
# Copy to config.yaml and edit before running.

# The canonical URL of this identity provider (used as OIDC issuer and DID:web base)
issuer: "https://identity.example.com"

# Path to the SQLite database file
db_path: "tpt-identity.db"

# HTTP server address
listen_addr: ":8080"

# Bearer token for the REST API (leave empty to disable auth — dev only)
api_key: "change-me-to-a-long-random-string"

identity:
  # Path to the Ed25519 private key PEM file (generated by `tpt-identity keygen`)
  signing_key: "ed25519.pem"
  # Path to the X25519 private key PEM file (optional, for encryption support)
  enc_key: "x25519.pem"
  # Passphrase used to decrypt the key files (leave empty if keys are unencrypted)
  passphrase: ""
  # Verification method ID in the DID document (default: <issuer>#signing-key-1)
  key_id: ""

# DID:web configuration — if your issuer domain is used as a did:web DID,
# tpt-identity serves the DID document at /.well-known/did.json automatically.
did_web:
  enabled: true
  domain: "identity.example.com"

# OIDC token lifetimes
oidc:
  id_token_ttl: "1h"
  access_token_ttl: "1h"
  code_ttl: "5m"

# Email delivery for magic-link login.
# Priority: tpt_email (signed) → email/smtp (raw) → stderr (dev mode, both empty).

# External OIDC identity providers (government IdPs, social login, etc.)
# Disabled by default — magic link is the only login method when this list is empty.
# The same bridge works for any OIDC-compliant IdP (RealMe, GOV.UK One Login, myID,
# Singpass, Login.gov, Google, Apple, etc.). Configure whichever apply to your jurisdiction.
# The callback URL registered with each IdP must be: {issuer}/auth/oidc/{name}/callback
oidc_providers: []
# Example — uncomment and fill in to enable:
# oidc_providers:
#   - name: realme
#     display_name: "RealMe (New Zealand)"
#     issuer: "https://mts.realme.govt.nz/realme-mts/token/oauth/authorize"
#     client_id: ""
#     client_secret: ""   # use TPT_IDENTITY_OIDC_PROVIDERS env not supported yet — use config file
#   - name: google
#     display_name: "Sign in with Google"
#     issuer: "https://accounts.google.com"
#     client_id: ""
#     client_secret: ""

# Option 1: tpt-email gateway (preferred — emails are cryptographically signed,
# making phishing detectable). Set base_url to your tpt-email instance.
tpt_email:
  base_url: ""           # e.g. https://mail.example.com  (leave empty to disable)
  api_key: ""            # use TPT_IDENTITY_TPT_EMAIL_API_KEY env var in production

# Option 2: raw SMTP (fallback when tpt_email.base_url is empty).
# Leave smtp_host empty in development — links are printed to stderr instead.
email:
  smtp_host: ""          # e.g. smtp.mailgun.org
  smtp_port: 587
  from: "noreply@identity.example.com"
  smtp_password: ""      # use TPT_IDENTITY_EMAIL_SMTP_PASSWORD env var in production

# Logging
log:
  level: "info"   # debug, info, warn, error
  format: "json"  # json or text
